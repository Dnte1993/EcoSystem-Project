<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EcoSystem.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EcoSystem.Client"
    xmlns:views="clr-namespace:EcoSystem.Client.Views"
    Title="EcoSystem.Client">

    <!-- Pestaña 1: Login -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"/>

    <!-- Pestaña 2: Inventario (GET) -->
    <ShellContent
        Title="Inventario"
        ContentTemplate="{DataTemplate views:ListaProductosPage}"
        Route="ListaProductosPage"/>

    <!-- Pestaña 3: Crear Producto (POST) -->
    <ShellContent
        Title="Agregar"
        ContentTemplate="{DataTemplate views:NuevoProductoPage}"
        Route="NuevoProductoPage"/>

    <!-- Botón de acción para Cerrar Sesión -->
    <MenuItem
        Text="Cerrar Sesión"
        Clicked="OnCerrarSesionClicked"/>

</Shell>