<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoSystem.Client.Views.NuevoProductoPage"
             Title="Agregar Producto"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <!-- Cambiamos a 3 filas: Formulario (Auto), Título de la lista (Auto) y Lista (*) -->
    <Grid RowDefinitions="Auto, Auto, *">

        <!-- ========================================== -->
        <!-- 1. MITAD SUPERIOR: FORMULARIO              -->
        <!-- ========================================== -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="30,30,30,10"
                             Spacing="15"
                             MaximumWidthRequest="450"
                             HorizontalOptions="Center">

            <Label Text="Agregar Producto"
                   Style="{StaticResource HeaderTitle}"
                   Margin="0,0,0,10"/>

            <Entry Placeholder="Nombre del Producto"
                   Text="{Binding Nombre}"/>

            <Entry Placeholder="Precio (Ej. 1500.50)"
                   Text="{Binding Precio}"
                   Keyboard="Numeric"/>

            <Entry Placeholder="Stock (Ej. 50)"
                   Text="{Binding Stock}"
                   Keyboard="Numeric"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource BrandPrimary}"
                               HorizontalOptions="Center"/>

            <Button Text="Agregar Producto"
                    Command="{Binding GuardarCommand}"
                    Style="{StaticResource PrimaryButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsBusy}"
                                 Value="True">
                        <Setter Property="IsEnabled"
                                Value="False"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>

        <!-- ========================================== -->
        <!-- 2. TÍTULO DE LA LISTA (Separado)           -->
        <!-- ========================================== -->
        <Label Grid.Row="1"
               Text="Agregados en esta sesión:"
               FontAttributes="Bold"
               FontSize="16"
               Margin="20,10,20,5"
               HorizontalOptions="Center"
               MaximumWidthRequest="450"
               HorizontalTextAlignment="Start"
               WidthRequest="450"
               TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark=White}"/>

        <!-- ========================================== -->
        <!-- 3. MITAD INFERIOR: LISTA DE AGREGADOS      -->
        <!-- ========================================== -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding ProductosRecientes}"
                        MaximumWidthRequest="450"
                        HorizontalOptions="Center"
                        Margin="20,0,20,20">

            <CollectionView.EmptyView>
                <!-- Al estar separado del título, este texto ya no se va a encimar -->
                <Label Text="Los productos que agregues aparecerán aquí abajo."
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray"
                       Margin="0,20,0,0"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="15"
                            Margin="0,5,0,10"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding Nombre}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>

                            <VerticalStackLayout Grid.Column="1"
                                    HorizontalOptions="End">
                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                       TextColor="{StaticResource BrandSecondary}"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>