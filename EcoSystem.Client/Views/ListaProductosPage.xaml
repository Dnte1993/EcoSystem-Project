<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoSystem.Client.Views.ListaProductosPage"
             Title="Lista de Productos">

    <Grid Padding="10">
        <!-- Indicador de carga conectado a IsBusy -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="Blue"
                           ZIndex="1"/>

        <!-- Lista dinámica de productos -->
        <CollectionView ItemsSource="{Binding Productos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5"
                            Padding="15"
                            CornerRadius="10"
                            HasShadow="True"
                            BorderColor="LightGray">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nombre}"
                                    FontSize="18"
                                    FontAttributes="Bold"/>
                            <Label Text="{Binding Precio, StringFormat='Precio: {0:C}'}"
                                    FontSize="14"
                                    TextColor="Green"
                                    Margin="0,5,0,0"/>
                            <Label Text="{Binding Stock, StringFormat='Stock en inventario: {0}'}"
                                    FontSize="14"
                                    TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>