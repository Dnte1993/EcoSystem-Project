<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoSystem.Client.ViewModels"
             x:Class="EcoSystem.Client.Views.LoginPage"
             Title="Iniciar Sesión"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

       <!-- Agregamos MaximumWidthRequest="450" para hacer el efecto de "tarjeta centrada" -->
       <VerticalStackLayout Padding="30"
                            Spacing="20"
                            VerticalOptions="Center"
                            MaximumWidthRequest="450">

              <Label Text="EcoSystem Connect"
                     Style="{StaticResource HeaderTitle}"/>

              <!-- Binding hacia la propiedad Email del ViewModel -->
              <Entry Placeholder="Correo Electrónico"
                     Text="{Binding Email}"
                     Keyboard="Email"/>

              <!-- Campo de contraseña manejado desde el code-behind por seguridad -->
              <Entry x:Name="txtContrasena"
                     Placeholder="Contraseña"
                     IsPassword="True"
                     TextChanged="txtContrasena_TextChanged"/>

              <!-- Binding hacia el comando LoginCommand del ViewModel -->
              <Button Text="Entrar"
                      Command="{Binding LoginCommand}"
                      Style="{StaticResource PrimaryButton}"/>

              <!-- Botón de Prueba para la Firma 3 -->
              <Button Text="Verificar Binding"
                      Command="{Binding VerificarCommand}"
                      Style="{StaticResource SecondaryButton}"/>

              <!-- NUEVO: Botón público para ir al registro -->
              <Button Text="¿No tienes cuenta? Regístrate aquí"
                      Style="{StaticResource SecondaryButton}"
                      Margin="0,15,0,0"
                      Clicked="OnIrARegistroClicked"/>

       </VerticalStackLayout>
</ContentPage>